# Modelo das variaveis de ambiente da interface.
# Copie para .env quando quiser apontar para uma API diferente da local:
#
#   cp .env.example .env
#
# No Vite, so variaveis com o prefixo VITE_ chegam ao navegador. Por isso NUNCA
# coloque segredo aqui: tudo neste arquivo vai junto no build e fica visivel
# para quem abrir o site.

# Endereco da API. Sem esta variavel o app usa http://localhost:3000.
# Producao: https://sua-api.onrender.com
VITE_API_URL=http://localhost:3000

# Chave publicavel do Stripe (Dashboard > Desenvolvedores > Chaves de API).
# Sem ela o app usa a chave de teste que ja vem no codigo.
VITE_STRIPE_PUBLIC_KEY=pk_test_sua_chave_aqui
