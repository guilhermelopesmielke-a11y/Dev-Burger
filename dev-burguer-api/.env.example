# Modelo das variaveis de ambiente da API.
# Copie este arquivo para .env e preencha com os seus valores:
#
#   cp .env.example .env
#
# O .env real NUNCA deve ser versionado (esta no .gitignore).

#SERVIDOR
# Em producao a plataforma de deploy define PORT sozinha - nao precisa setar.
PORT=3000
# Endereco publico DESTA api. E com ele que o back monta a URL das imagens dos
# produtos e categorias. Em producao: https://sua-api.onrender.com
APP_URL=http://localhost:3000

#BANCO POSTGRES
# Opcao A (producao): string unica de conexao dada pelo Neon/Supabase/Render.
# Quando ela existe, as cinco variaveis abaixo sao ignoradas e o SSL liga sozinho.
# DATABASE_URL=postgresql://usuario:senha@host.neon.tech/nomedobanco?sslmode=require

# Opcao B (local): as credenciais do seu docker-compose.yml, uma a uma.
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=dev-burguer-db
# Forca ligar/desligar SSL. Deixe vazio para o padrao: ligado com DATABASE_URL,
# desligado com o Postgres local do docker.
DB_SSL=

#BANCO MONGO
# Local: mongodb://127.0.0.1:27017/devburguer
# Producao (MongoDB Atlas): mongodb+srv://usuario:senha@cluster.mongodb.net/devburguer
MONGO_URL=mongodb://127.0.0.1:27017/devburguer

#AUTENTICACAO
# Segredo que assina os tokens JWT. Gere o seu com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=gere_o_seu_segredo_aqui
JWT_EXPIRES_IN=7d

#STRIPE
# Chave secreta do Stripe (Dashboard > Desenvolvedores > Chaves de API)
STRIPE_SECRET_KEY=sk_test_sua_chave_aqui
# Segredo do webhook. Rodando local com `stripe listen`, o CLI imprime este
# valor ao iniciar - ele muda a cada maquina/sessao. Em producao o valor vem do
# endpoint cadastrado no painel do Stripe.
STRIPE_WEBHOOK_SECRET=whsec_seu_segredo_aqui

#FRONTEND
# URL do front-end. Usada pelo Stripe para redirecionar apos o checkout E pelo
# CORS para decidir quem pode chamar a API. Aceita varias separadas por virgula.
# Producao: https://seu-projeto.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173
