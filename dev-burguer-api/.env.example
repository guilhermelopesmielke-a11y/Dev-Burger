# Modelo das variaveis de ambiente da API.
# Neste projeto o .env real tambem esta versionado (repositorio privado),
# entao este arquivo serve como referencia do que cada variavel significa.

#STRIPE
# Chave secreta do Stripe (Dashboard > Desenvolvedores > Chaves de API)
STRIPE_SECRET_KEY='sk_test_sua_chave_aqui'

#FRONTEND
# URL do front-end, usada pelo Stripe para redirecionar apos o checkout
FRONTEND_URL='http://localhost:5173'

STRIPE_WEBHOOK_SECRET=whsec_...
