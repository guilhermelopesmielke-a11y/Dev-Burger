logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editores
.vscode/*
.idea/
*.sw?

# Infra local com credenciais reais
docker-compose.yml
docker-compose.override.yml
!docker-compose.example.yml

# Ferramentas de IA
.claude/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini
