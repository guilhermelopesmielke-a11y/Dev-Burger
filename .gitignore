# ============================================================
# .gitignore raiz - vale para todo o monorepo (API + interface)
# ============================================================

# ---------- SEGREDOS (nunca versionar) ----------
.env
.env.*
**/.env
**/.env.*
# excecao: o modelo sem valores reais deve continuar versionado
!.env.example
!**/.env.example

# Certificados e chaves
*.pem
*.key
*.p12
*.pfx
*.crt

# Infra local com credenciais reais (use o docker-compose.example.yml como modelo)
docker-compose.yml
docker-compose.override.yml
**/docker-compose.yml
**/docker-compose.override.yml
!docker-compose.example.yml
!**/docker-compose.example.yml

# ---------- Dumps e backups de banco ----------
*.sql
*.dump
*.archive
*.sqlite
*.sqlite3
*.db
# excecao: migrations em SQL, se existirem, devem ser versionadas
!**/migrations/*.sql
# excecao: catalogo inicial, sem dado de usuario - o backup.sql completo
# continua ignorado porque carrega hash de senha de conta real
!dev-burguer-api/seed.sql

# ---------- Projeto de terceiros (seed do curso) ----------
seed-devburger-api/

# ---------- Backups do historico git antigo das subpastas ----------
.git-old/
**/.git-old/

# ---------- Dependencias (reinstalaveis com `pnpm install`) ----------
node_modules/
**/node_modules/
.pnp
.pnp.js

# ---------- Build gerado ----------
dist/
dist-ssr/
build/
**/dist/
**/build/
*.local

# ---------- Cache de ferramentas ----------
.vite/
**/.vite/
.cache/
.parcel-cache/
.turbo/
.eslintcache
*.tsbuildinfo

# ---------- Testes / cobertura ----------
coverage/
**/coverage/
.nyc_output/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ---------- Editores e IDEs ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- Ferramentas de IA / assistentes ----------
.claude/
**/.claude/
.cursor/
.aider*

# ---------- Sistema operacional ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
